# Grafana
# icon: fa-solid fa-chart-line
    tls /etc/ssl/certs/fullchain1.pem /etc/ssl/certs/privkey1.pem
grafana.example.com {
    reverse_proxy 192.168.1.250:80
        transport http {
            tls_insecure_skip_verify
        }
}

# Router
router.example.com {
tls /etc/ssl/certs/fullchain1.pem /etc/ssl/certs/privkey1.pem
    reverse_proxy 192.168.1.200:80
}

# Test
test.example.com {
    tls internal
    reverse_proxy 192.168.1.100:80
}
